[
  {
    "kernelSource": {
      "device": "ruby",
      "vendor": "xiaomi",
      "name": "Aeron-Phoenix",
      "defconfig": "ruby_defconfig",
      "extraConfig": ["vendor/kernelsu.config", "vendor/susfs.config"],
      "repo": "https://github.com/DPR-MoonWake/aeron_kernel_xiaomi_ruby",
      "branch": "ksu_susfs"
    },
    "output_image": "Image.gz-dtb",
    "kernelsu": {
      "enable": true,
      "setupLink": "https://raw.githubusercontent.com/XDL-MoonWake/KernelSU-Next/refs/heads/legacy-susfs-v2/kernel/setup.sh",
      "setupArg": "legacy-susfs-v2"
    },
    "toolchains": [
      {
        "name": "clang-AOSP",
        "url": "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/main/clang-r522817.tar.gz",
        "binPath": ["bin"]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "build_out": "Image.gz-dtb",
      "externalCommand": {
        "LLVM": "1",
        "LLVM_IAS": "1",
        "KBUILD_BUILD_HOST": "gmail.com",
        "KBUILD_BUILD_USER": "aeronrules2",
        "CROSS_COMPILE": "aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
        "LD": "ld.lld",
        "AR": "llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "READELF": "llvm-readelf",
        "STRIP": "llvm-strip"
      }
    },
    "AnyKernel3": {
      "use": "true",
      "repo": "https://github.com/DPR-MoonWake/AnyKernel3",
      "branch": "aeron"
    }
  }
]